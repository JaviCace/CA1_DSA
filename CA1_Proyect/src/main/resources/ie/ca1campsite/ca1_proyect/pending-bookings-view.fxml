<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ie.ca1campsite.ca1_proyect.ui.PendingBookingsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Pending bookings" />
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Campsite" />
                <ComboBox fx:id="campsiteCombo" prefWidth="250.0" promptText="Choose a campsite" />
                <Button onAction="#onShowCampsite" text="Show this campsite" />
                <Button onAction="#onShowAll" text="Show the whole system" />
            </children>
        </HBox>
        <TextArea fx:id="reportArea" editable="false" style="-fx-font-family: monospace;" VBox.vgrow="ALWAYS" />
        <HBox spacing="10.0">
            <children>
                <Button onAction="#onBack" text="Back" />
            </children>
        </HBox>
    </children>
</VBox>
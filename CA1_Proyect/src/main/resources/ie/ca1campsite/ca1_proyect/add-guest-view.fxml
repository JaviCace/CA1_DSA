<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ie.ca1campsite.ca1_proyect.ui.AddGuestController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Add a guest" />
        <GridPane hgap="10.0" vgap="10.0">
            <children>
                <Label text="Name" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="nameField" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Date of birth" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <DatePicker fx:id="birthPicker" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Address" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="addressField" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Phone" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="phoneField" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label text="Email" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="emailField" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <Label text="Notes" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <TextArea fx:id="notesArea" prefHeight="80.0" prefWidth="300.0" promptText="Any other useful information" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </children>
        </GridPane>
        <HBox spacing="10.0">
            <children>
                <Button onAction="#onBack" text="Back" />
                <Button onAction="#onSave" text="Add guest" />
            </children>
        </HBox>
    </children>
</VBox>
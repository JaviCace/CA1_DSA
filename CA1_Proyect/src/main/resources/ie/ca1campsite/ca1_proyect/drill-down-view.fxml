<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ie.ca1campsite.ca1_proyect.ui.DrillDownController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Browse campsites (drill-down)" />
        <HBox spacing="10.0">
            <children>
                <Button onAction="#onExpandAll" text="Expand all" />
                <Button onAction="#onRefresh" text="Refresh" />
            </children>
        </HBox>
        <SplitPane dividerPositions="0.45" VBox.vgrow="ALWAYS">
            <items>
                <TreeView fx:id="treeView" />
                <TextArea fx:id="detailsArea" editable="false" style="-fx-font-family: monospace;" wrapText="true" />
            </items>
        </SplitPane>
        <HBox spacing="10.0">
            <children>
                <Button onAction="#onBack" text="Back" />
            </children>
        </HBox>
    </children>
</VBox>
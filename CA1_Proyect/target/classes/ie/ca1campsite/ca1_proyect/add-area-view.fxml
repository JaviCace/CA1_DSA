<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ie.ca1campsite.ca1_proyect.ui.AddAreaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Add a camping area" />
        <GridPane hgap="10.0" vgap="10.0">
            <children>
                <Label text="Campsite" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ComboBox fx:id="campsiteCombo" prefWidth="300.0" promptText="Choose a campsite" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Identifier" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="identifierField" prefWidth="300.0" promptText="For example: Lake View Area 1" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Description" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextArea fx:id="descriptionArea" prefHeight="100.0" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
        </GridPane>
        <HBox spacing="10.0">
            <children>
                <Button onAction="#onBack" text="Back" />
                <Button onAction="#onSave" text="Add area" />
            </children>
        </HBox>
    </children>
</VBox>
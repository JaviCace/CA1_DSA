<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>

<BorderPane fx:id="rootPane" prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ie.ca1campsite.ca1_proyect.ui.MainController">
    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <menus>
                <Menu text="File">
                    <items>
                        <MenuItem onAction="#onSave" text="Save data..." />
                        <MenuItem onAction="#onLoad" text="Load data..." />
                        <MenuItem onAction="#onLoadSample" text="Load sample data" />
                        <SeparatorMenuItem />
                        <MenuItem onAction="#onReset" text="Reset all data" />
                        <SeparatorMenuItem />
                        <MenuItem onAction="#onExit" text="Exit" />
                    </items>
                </Menu>
                <Menu text="Campsites">
                    <items>
                        <MenuItem onAction="#onAddCampsite" text="Add campsite..." />
                        <MenuItem onAction="#onAddArea" text="Add camping area..." />
                        <MenuItem onAction="#onAddPlot" text="Add plot / pitch..." />
                    </items>
                </Menu>
                <Menu text="Guests">
                    <items>
                        <MenuItem onAction="#onAddGuest" text="Add guest..." />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
    <center>
        <StackPane fx:id="contentPane" BorderPane.alignment="CENTER">
            <children>
                <Label text="Welcome to the Campsite Management System" />
            </children>
        </StackPane>
    </center>
    <bottom>
        <Label fx:id="statusLabel" text="Ready" BorderPane.alignment="CENTER_LEFT">
            <padding>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </padding>
        </Label>
    </bottom>
</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ie.ca1campsite.ca1_proyect.ui.RemovePlotController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Remove a plot / pitch" />
        <GridPane hgap="10.0" vgap="10.0">
            <children>
                <Label text="Campsite" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ComboBox fx:id="campsiteCombo" onAction="#onCampsiteSelected" prefWidth="300.0" promptText="Choose a campsite" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Camping area" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="areaCombo" onAction="#onAreaSelected" prefWidth="300.0" promptText="Choose an area" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Plot" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <ComboBox fx:id="plotCombo" prefWidth="300.0" promptText="Choose a plot" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
        </GridPane>
        <HBox spacing="10.0">
            <children>
                <Button onAction="#onBack" text="Back" />
                <Button onAction="#onRemove" text="Remove plot" />
            </children>
        </HBox>
    </children>
</VBox>
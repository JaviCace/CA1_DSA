<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ie.ca1campsite.ca1_proyect.ui.AddPlotController">
    <content>
        <VBox spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Add a plot / pitch" />
                <GridPane hgap="10.0" vgap="10.0">
                    <children>
                        <Label text="Campsite" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <ComboBox fx:id="campsiteCombo" onAction="#onCampsiteSelected" prefWidth="300.0" promptText="Choose a campsite" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label text="Camping area" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <ComboBox fx:id="areaCombo" prefWidth="300.0" promptText="Choose an area" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Identifier" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="idField" prefWidth="300.0" promptText="For example: B1" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label text="Type" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <ComboBox fx:id="typeCombo" onAction="#onTypeSelected" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <Label text="Has power" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <CheckBox fx:id="poweredCheck" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                        <Label text="Bedrooms" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                        <Spinner fx:id="bedroomsSpinner" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                        <Label text="Beds" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                        <Spinner fx:id="bedsSpinner" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                        <Label text="Size (square metres)" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                        <TextField fx:id="sizeField" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                        <Label text="Cost per night (EUR)" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                        <TextField fx:id="costField" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                        <Label text="Photo URL" GridPane.columnIndex="0" GridPane.rowIndex="9" />
                        <TextField fx:id="photoField" prefWidth="300.0" promptText="http://..." GridPane.columnIndex="1" GridPane.rowIndex="9" />
                    </children>
                </GridPane>
                <Label text="Facilities" />
                <FlowPane hgap="15.0" vgap="8.0">
                    <children>
                        <CheckBox fx:id="airConditioningCheck" text="Air conditioning" />
                        <CheckBox fx:id="heatingCheck" text="Heating" />
                        <CheckBox fx:id="barbecueCheck" text="Barbecue" />
                        <CheckBox fx:id="bathroomCheck" text="Private bathroom" />
                    </children>
                </FlowPane>
                <HBox spacing="10.0">
                    <children>
                        <Button onAction="#onBack" text="Back" />
                        <Button onAction="#onSave" text="Add plot" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </content>
</ScrollPane>